{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "brightscript",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_terminator"
      }
    },
    "_terminator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "'[^\\r\\n]*"
          },
          {
            "type": "PATTERN",
            "value": "[rR][eE][mM]([ \\t][^\\r\\n]*)?"
          }
        ]
      }
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[iI][nN][tT][eE][gG][eE][rR]"
          },
          "named": false,
          "value": "integer"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[fF][lL][oO][aA][tT]"
          },
          "named": false,
          "value": "float"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[dD][oO][uU][bB][lL][eE]"
          },
          "named": false,
          "value": "double"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[bB][oO][oO][lL][eE][aA][nN]"
          },
          "named": false,
          "value": "boolean"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[sS][tT][rR][iI][nN][gG]"
          },
          "named": false,
          "value": "string"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[oO][bB][jJ][eE][cC][tT]"
          },
          "named": false,
          "value": "object"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[dD][yY][nN][aA][mM][iI][cC]"
          },
          "named": false,
          "value": "dynamic"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[fF][uU][nN][cC][tT][iI][oO][nN]"
          },
          "named": false,
          "value": "function"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[vV][oO][iI][dD]"
          },
          "named": false,
          "value": "void"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "(\\d+(\\.\\d+)?|\\.\\d+)([eEdD][+-]?\\d+)?[%!#&]?"
          },
          {
            "type": "PATTERN",
            "value": "&[hH][0-9a-fA-F]+&?"
          }
        ]
      }
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\r\\n]|\"\")*\""
    },
    "true": {
      "type": "PATTERN",
      "value": "[tT][rR][uU][eE]"
    },
    "false": {
      "type": "PATTERN",
      "value": "[fF][aA][lL][sS][eE]"
    },
    "invalid": {
      "type": "PATTERN",
      "value": "[iI][nN][vV][aA][lL][iI][dD]"
    },
    "source_literal": {
      "type": "PATTERN",
      "value": "[lL][iI][nN][eE]_[nN][uU][mM]"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*[$%!#&]?"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}