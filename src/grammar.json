{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "brightscript",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_terminator"
      }
    },
    "_terminator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "'[^\\r\\n]*"
          },
          {
            "type": "PATTERN",
            "value": "[rR][eE][mM]([ \\t][^\\r\\n]*)?"
          }
        ]
      }
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "true"
        },
        {
          "type": "SYMBOL",
          "name": "false"
        },
        {
          "type": "SYMBOL",
          "name": "invalid"
        },
        {
          "type": "SYMBOL",
          "name": "source_literal"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_expression"
        },
        {
          "type": "SYMBOL",
          "name": "call_expression"
        },
        {
          "type": "SYMBOL",
          "name": "member_expression"
        },
        {
          "type": "SYMBOL",
          "name": "index_expression"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_expression"
        }
      ]
    },
    "_postfix_operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_expression"
        },
        {
          "type": "SYMBOL",
          "name": "call_expression"
        },
        {
          "type": "SYMBOL",
          "name": "member_expression"
        },
        {
          "type": "SYMBOL",
          "name": "index_expression"
        },
        {
          "type": "SYMBOL",
          "name": "attribute_expression"
        }
      ]
    },
    "parenthesized_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "call_expression": {
      "type": "PREC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "function",
            "content": {
              "type": "SYMBOL",
              "name": "_postfix_operand"
            }
          },
          {
            "type": "FIELD",
            "name": "arguments",
            "content": {
              "type": "SYMBOL",
              "name": "argument_list"
            }
          }
        ]
      }
    },
    "argument_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "STRING",
              "value": "?("
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "expression"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ","
                      },
                      {
                        "type": "SYMBOL",
                        "name": "expression"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "member_expression": {
      "type": "PREC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "object",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_postfix_operand"
                },
                {
                  "type": "SYMBOL",
                  "name": "number"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "."
              },
              {
                "type": "STRING",
                "value": "?."
              }
            ]
          },
          {
            "type": "FIELD",
            "name": "property",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          }
        ]
      }
    },
    "index_expression": {
      "type": "PREC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "object",
            "content": {
              "type": "SYMBOL",
              "name": "_postfix_operand"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "STRING",
                "value": "?["
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "index",
                "content": {
                  "type": "SYMBOL",
                  "name": "expression"
                }
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": ","
                    },
                    {
                      "type": "FIELD",
                      "name": "index",
                      "content": {
                        "type": "SYMBOL",
                        "name": "expression"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "attribute_expression": {
      "type": "PREC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "object",
            "content": {
              "type": "SYMBOL",
              "name": "_postfix_operand"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "@"
              },
              {
                "type": "STRING",
                "value": "?@"
              }
            ]
          },
          {
            "type": "FIELD",
            "name": "attribute",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          }
        ]
      }
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[iI][nN][tT][eE][gG][eE][rR]"
          },
          "named": false,
          "value": "integer"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[fF][lL][oO][aA][tT]"
          },
          "named": false,
          "value": "float"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[dD][oO][uU][bB][lL][eE]"
          },
          "named": false,
          "value": "double"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[bB][oO][oO][lL][eE][aA][nN]"
          },
          "named": false,
          "value": "boolean"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[sS][tT][rR][iI][nN][gG]"
          },
          "named": false,
          "value": "string"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[oO][bB][jJ][eE][cC][tT]"
          },
          "named": false,
          "value": "object"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[dD][yY][nN][aA][mM][iI][cC]"
          },
          "named": false,
          "value": "dynamic"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[fF][uU][nN][cC][tT][iI][oO][nN]"
          },
          "named": false,
          "value": "function"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[vV][oO][iI][dD]"
          },
          "named": false,
          "value": "void"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "(\\d+(\\.\\d+)?|\\.\\d+)([eEdD][+-]?\\d+)?[%!#&]?"
          },
          {
            "type": "PATTERN",
            "value": "&[hH][0-9a-fA-F]+&?"
          }
        ]
      }
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\r\\n]|\"\")*\""
    },
    "true": {
      "type": "PATTERN",
      "value": "[tT][rR][uU][eE]"
    },
    "false": {
      "type": "PATTERN",
      "value": "[fF][aA][lL][sS][eE]"
    },
    "invalid": {
      "type": "PATTERN",
      "value": "[iI][nN][vV][aA][lL][iI][dD]"
    },
    "source_literal": {
      "type": "PATTERN",
      "value": "[lL][iI][nN][eE]_[nN][uU][mM]"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*[$%!#&]?"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [
    "_postfix_operand"
  ],
  "supertypes": [
    "expression"
  ],
  "reserved": {}
}